<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BorrowBox - Campus Item Lending Platform</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header>
    <h1>📦 BorrowBox</h1>
    <p>Campus Item Lending Platform &mdash; borrow and lend with your fellow students</p>
  </header>
  <main>
    <div class="toolbar">
      <a href="/items/new" class="btn">+ List an item</a>
    </div>

    <% if (items.length === 0) { %>
      <p class="empty">No items listed yet. Be the first to add one!</p>
    <% } else { %>
      <% items.forEach(function(item) { %>
        <div class="item-card">
          <div class="item-info">
            <h3><%= item.name %></h3>
            <p><%= item.category %> &middot; Owner: <%= item.owner %></p>
          </div>
          <div class="item-actions">
            <span class="status <%= item.available ? 'available' : 'unavailable' %>">
              <%= item.available ? 'Available' : 'Borrowed' %>
            </span>
            <% if (item.available) { %>
              <form class="inline" method="POST" action="/items/<%= item.id %>/request">
                <button type="submit" class="btn secondary">Request</button>
              </form>
            <% } else { %>
              <form class="inline" method="POST" action="/items/<%= item.id %>/return">
                <button type="submit" class="btn secondary">Return</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }); %>
    <% } %>
  </main>
</body>
</html>
