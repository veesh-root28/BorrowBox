<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>List an Item - BorrowBox</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header>
    <h1>📦 BorrowBox</h1>
    <p>List a new item to lend</p>
  </header>
  <main>
    <div class="form-card">
      <form method="POST" action="/items">
        <label for="name">Item name</label>
        <input type="text" id="name" name="name" placeholder="e.g. Scientific Calculator" required />

        <label for="owner">Your name</label>
        <input type="text" id="owner" name="owner" placeholder="e.g. Vishruth" required />

        <label for="category">Category</label>
        <select id="category" name="category" required>
          <option value="Electronics">Electronics</option>
          <option value="Books">Books</option>
          <option value="Stationery">Stationery</option>
          <option value="Sports">Sports</option>
          <option value="Other">Other</option>
        </select>

        <div class="toolbar" style="margin-top: 1.2rem;">
          <a href="/" class="btn secondary">Cancel</a>
          <button type="submit" class="btn">List item</button>
        </div>
      </form>
    </div>
  </main>
</body>
</html>
